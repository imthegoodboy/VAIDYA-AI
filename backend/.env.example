OPENAI_API_KEY=
# Optional: require this header value for POST /ingest (omit to allow open ingest in dev)
INGEST_TOKEN=

CHROMA_PATH=../vector_store
# Local Sentence Transformers model (downloads on first use). Re-ingest if you change it.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=../data

# Optional: cache embed_query() vectors when a local Redis service is available.
REDIS_URL=
EMBEDDING_CACHE_TTL_SECONDS=86400

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
MAX_URL_BYTES=2000000
URL_FETCH_TIMEOUT=60


OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_PLANT_VISION_MODEL=gpt-4.1

# Prescription uploads + Tavily (optional)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
PRESCRIPTION_EXTRACTION_MIN_CHARS=80
VISION_PDF_MAX_PAGES=3
TAVILY_API_KEY=
TAVILY_TRUSTED_DOMAINS=fda.gov,nih.gov,who.int,nlm.nih.gov,ncbi.nlm.nih.gov,medlineplus.gov
UNSPLASH_ACCESS_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk auth (required when using fronteend-1)
# Example issuer: https://your-clerk-domain.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_JWKS_URL=
CLERK_JWT_LEEWAY_SECONDS=120

# Local dev uses SQLite by default. For production or a local Postgres service,
# set: postgresql+psycopg://rag:rag@127.0.0.1:5432/ragchat
DATABASE_URL=sqlite:///./ragchat.db
CHAT_HISTORY_LIMIT=20
SESSION_SUMMARY_MAX_CHARS=2000
CHAT_HISTORY_MAX_CHARS=12000
